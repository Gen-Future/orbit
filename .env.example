# Copy to .env. Replace secrets before exposing the app.
DATABASE_URL=postgresql://orbit:orbit@localhost:55432/orbit
REDIS_URL=redis://localhost:56379
APP_URL=http://localhost:3000
ALLOW_REGISTRATION=true
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=
AI_PROVIDER=openai
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# One-time provisioning command: npm run admin:provision
# ORBIT_ADMIN_EMAIL and ORBIT_ADMIN_PASSWORD should be passed only to that command.
AI_ENDPOINT_NAME=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Generate: npx web-push generate-vapid-keys
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Docker deployment
POSTGRES_PASSWORD=replace-with-a-long-random-password
ORBIT_DOMAIN=orbit.example.com
